{
	"name": "n8n-nodes-spicrawl",
	"version": "0.1.0",
	"description": "n8n community node for Spicrawl: scrape any URL to markdown, HTML, text, PDF or structured JSON, and run batch scrape jobs.",
	"license": "MIT",
	"homepage": "https://github.com/OfficialSpicrawl/agent-plugins/tree/main/n8n#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"spicrawl",
		"web scraping",
		"scraper",
		"markdown",
		"crawler"
	],
	"author": {
		"name": "Spicrawl",
		"email": "support@spicrawl.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OfficialSpicrawl/agent-plugins.git",
		"directory": "n8n"
	},
	"bugs": {
		"url": "https://github.com/OfficialSpicrawl/agent-plugins/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "node test/smoke.cjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SpicrawlApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Spicrawl/Spicrawl.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.51.5",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
